# Kopiraj ovu datoteku u ".env" i upisi svoje podatke.
GARMIN_EMAIL=tvoj@email.com
GARMIN_PASSWORD=tvoja_lozinka

# Samo za garmin_backend.py (Render deploy) - lokalno obicno nije potrebno
# ako je serviceAccountKey.json vec u ovoj mapi.
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Push notifikacije (Web Push, besplatno). Generirano lokalno u
# vapid_private.pem / vapid_public.txt - na Render ide kao Secret File,
# putanju do njega upisi ovdje.
VAPID_PRIVATE_KEY_PATH=./vapid_private.pem
VAPID_SUBJECT=mailto:tvoj@email.com

# Nasumicna tajna koju provjerava /push/provjeri-kilometrazu da je ne moze
# bilo tko s interneta okidati - isti string ide i u GitHub Actions secret.
CRON_SECRET=generiraj_nasumican_string

# iCloud "Public Calendar" linkovi (iz Calendar app -> kalendar -> Public
# Calendar -> Share Link), JSON objekt {"Naziv kalendara": "https://..."}.
# webcal:// zamijeni s https:// kad kopiras ovamo.
ICLOUD_KALENDARI={"Naziv": "https://p000-caldav.icloud.com/published/2/..."}

# Lokacija za vremensku prognozu (Open-Meteo, besplatno, bez kljuca)
VREME_LAT=44.8666
VREME_LON=13.8496
